# notation/archimate/layer-crossing - Which asserted pairs cross ArchiMate layers?
#
# Answers: distinct source-target pairs per relationship type and layer pair,
# using direct triples and the attached ontology's class hierarchy. This is the
# same counting unit and output as the published model question of this name.
#
# Does NOT prove: correctness or completeness of the architecture. Potential
# derivations assert no direct triple and are not counted. Load the ArchiMate
# ontology as vocabulary; specialisations follow its class hierarchy.
#
# Parameters: LIMIT
{{PREFIXES}}
SELECT ?sourceLayer ?relationshipType ?targetLayer (COUNT(DISTINCT ?pair) AS ?relationships)
WHERE {
  # Each relationship by its direct triple, with the type it is the unqualified form of.
  VALUES (?predicate ?relationshipType) {
    (am:composedOf am:Composition) (am:aggregates am:Aggregation) (am:assignedTo am:Assignment)
    (am:realizes am:Realization) (am:serves am:Serving) (am:accesses am:Access)
    (am:influences am:Influence) (am:associatedWith am:Association) (am:triggers am:Triggering)
    (am:flowsTo am:Flow) (am:specializes am:Specialization)
  }
  {{GRAPH_OPEN:semantic}}
  ?source ?predicate ?target .
  BIND(CONCAT(STR(?source), " ", STR(?target)) AS ?pair)
  ?source rdf:type ?sourceType .
  ?target rdf:type ?targetType .
  {{GRAPH_CLOSE}}
  {
    SELECT DISTINCT ?sourceLayer ?sourceType
    WHERE {
      VALUES ?sourceLayer {
        am:StrategyLayerElement am:MotivationElement am:BusinessLayerElement am:ApplicationLayerElement
        am:TechnologyLayerElement am:PhysicalLayerElement am:ImplementationAndMigrationLayerElement
      }
      {{GRAPH_OPEN:vocabulary}}
      ?sourceType rdfs:subClassOf* ?sourceLayer .
      {{GRAPH_CLOSE}}
    }
  }
  {
    SELECT DISTINCT ?targetLayer ?targetType
    WHERE {
      VALUES ?targetLayer {
        am:StrategyLayerElement am:MotivationElement am:BusinessLayerElement am:ApplicationLayerElement
        am:TechnologyLayerElement am:PhysicalLayerElement am:ImplementationAndMigrationLayerElement
      }
      {{GRAPH_OPEN:vocabulary}}
      ?targetType rdfs:subClassOf* ?targetLayer .
      {{GRAPH_CLOSE}}
    }
  }
  FILTER(?sourceLayer != ?targetLayer)
}
GROUP BY ?sourceLayer ?relationshipType ?targetLayer
ORDER BY DESC(?relationships)
LIMIT {{LIMIT}}
