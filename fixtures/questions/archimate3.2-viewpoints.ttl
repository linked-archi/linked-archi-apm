amvp:OrganizationViewpoint a arch:Viewpoint ;
	skos:prefLabel "Organization Viewpoint"@en ;
	skos:definition "The structure of an organization: its business actors, roles and collaborations, where they are, and the interfaces through which they are reached."@en ;
	arch:includesConcept am:BusinessActor , am:BusinessRole , am:BusinessCollaboration , am:Location , am:BusinessInterface , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:EnterpriseArchitect , amvp:ProcessArchitect , amvp:DomainArchitect , amvp:Manager , amvp:Employee , amvp:Shareholder ;
	arch:viewpointFramesConcern amvp:CompetenciesAuthorityResponsibilities ;
	arch:viewpointHasPurpose amvp:Designing , amvp:Deciding , amvp:Informing ;
	arch:viewType arch:Diagram , arch:Catalog ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:SingleLayerSingleAspect ;
	skos:notation "C.1.1" .
amvp:ApplicationStructureViewpoint a arch:Viewpoint ;
	skos:prefLabel "Application Structure Viewpoint"@en ;
	skos:definition "The structure of one or more applications: their components, interfaces and data, and the collaborations they take part in."@en ;
	arch:includesConcept am:ApplicationComponent , am:ApplicationInterface , am:ApplicationCollaboration , am:DataObject , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:ApplicationArchitect , amvp:SolutionArchitect ;
	arch:viewpointFramesConcern amvp:ApplicationStructure , amvp:Consistency , amvp:Completeness , amvp:ReductionOfComplexity ;
	arch:viewpointHasPurpose amvp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:SingleLayerMultipleAspects ;
	skos:notation "C.1.2" .
amvp:InformationStructureViewpoint a arch:Viewpoint ;
	skos:prefLabel "Information Structure Viewpoint"@en ;
	skos:definition "The structure of the information the enterprise uses: business and data objects, their representations, the artifacts that hold them and what they mean."@en ;
	arch:includesConcept am:BusinessObject , am:Representation , am:DataObject , am:Artifact , am:Meaning , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:DomainArchitect , amvp:InformationArchitect ;
	arch:viewpointFramesConcern amvp:InformationStructure , amvp:Consistency , amvp:Completeness ;
	arch:viewpointHasPurpose amvp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:MultipleLayersSingleAspect ;
	skos:notation "C.1.3" .
amvp:TechnologyViewpoint a arch:Viewpoint ;
	skos:prefLabel "Technology Viewpoint"@en ;
	skos:definition "The infrastructure and platforms beneath the information systems — nodes, devices, system software and networks — and the technology behaviour they offer."@en ;
	arch:includesConcept am:Location , am:Node , am:TechnologyCollaboration , am:Device , am:SystemSoftware , am:TechnologyInterface , am:CommunicationNetwork , am:Path , am:TechnologyProcess , am:TechnologyFunction , am:TechnologyInteraction , am:TechnologyService , am:TechnologyEvent , am:Artifact , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:InfrastructureArchitect , amvp:OperationalManager ;
	arch:viewpointFramesConcern amvp:InfrastructureQuality ;
	arch:viewpointHasPurpose amvp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:SingleLayerMultipleAspects ;
	skos:notation "C.1.4" .
amvp:LayeredViewpoint a arch:Viewpoint ;
	skos:prefLabel "Layered Viewpoint"@en ;
	skos:definition "An overview of the architecture across its layers in one diagram: every core element, and every relationship, may appear."@en ;
	arch:includesConcept am:BusinessActor , am:BusinessRole , am:BusinessCollaboration , am:BusinessInterface , am:BusinessProcess , am:BusinessFunction , am:BusinessInteraction , am:BusinessEvent , am:BusinessService , am:BusinessObject , am:Contract , am:Representation , am:Product , am:ApplicationComponent , am:ApplicationCollaboration , am:ApplicationInterface , am:ApplicationFunction , am:ApplicationInteraction , am:ApplicationProcess , am:ApplicationEvent , am:ApplicationService , am:DataObject , am:Node , am:Device , am:SystemSoftware , am:TechnologyCollaboration , am:TechnologyInterface , am:Path , am:CommunicationNetwork , am:TechnologyFunction , am:TechnologyProcess , am:TechnologyInteraction , am:TechnologyEvent , am:TechnologyService , am:Artifact , am:Equipment , am:Facility , am:DistributionNetwork , am:Material , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:EnterpriseArchitect , amvp:ProcessArchitect , amvp:ApplicationArchitect , amvp:InfrastructureArchitect , amvp:DomainArchitect ;
	arch:viewpointFramesConcern amvp:Consistency , amvp:ReductionOfComplexity , amvp:ImpactOfChange , amvp:Flexibility ;
	arch:viewpointHasPurpose amvp:Designing , amvp:Deciding , amvp:Informing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:MultipleLayersMultipleAspects ;
	skos:notation "C.1.5" .
amvp:PhysicalViewpoint a arch:Viewpoint ;
	skos:prefLabel "Physical Viewpoint"@en ;
	skos:definition "The physical environment — equipment, facilities, distribution networks and materials — and how it relates to the IT infrastructure."@en ;
	arch:includesConcept am:Location , am:Node , am:Device , am:Equipment , am:Facility , am:Path , am:CommunicationNetwork , am:DistributionNetwork , am:Material , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:InfrastructureArchitect , amvp:OperationalManager ;
	arch:viewpointFramesConcern amvp:PhysicalEnvironment ;
	arch:viewpointHasPurpose amvp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:CompositionViewpoints , amvp:MultipleLayersMultipleAspects ;
	skos:notation "C.1.6" .
amvp:ProductViewpoint a arch:Viewpoint ;
	skos:prefLabel "Product Viewpoint"@en ;
	skos:definition "What a product contains: the services, behaviour, objects, contracts and value it offers, and who delivers it."@en ;
	arch:includesConcept am:BusinessActor , am:BusinessRole , am:BusinessCollaboration , am:BusinessInterface , am:BusinessProcess , am:BusinessFunction , am:BusinessInteraction , am:BusinessEvent , am:BusinessService , am:BusinessObject , am:Product , am:Contract , am:ApplicationComponent , am:ApplicationCollaboration , am:ApplicationInterface , am:ApplicationProcess , am:ApplicationFunction , am:ApplicationInteraction , am:ApplicationEvent , am:ApplicationService , am:DataObject , am:TechnologyService , am:Artifact , am:Material , am:Value , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:ProductDeveloper , amvp:ProductManager , amvp:ProcessArchitect , amvp:DomainArchitect ;
	arch:viewpointFramesConcern amvp:ProductDevelopment , amvp:ProductValue ;
	arch:viewpointHasPurpose amvp:Designing , amvp:Deciding ;
	arch:viewType arch:Diagram , arch:Catalog ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:SupportViewpoints , amvp:MultipleLayersMultipleAspects ;
	skos:notation "C.1.7" .
amvp:ApplicationUsageViewpoint a arch:Viewpoint ;
	skos:prefLabel "Application Usage Viewpoint"@en ;
	skos:definition "How applications are used in the enterprise's business processes and functions, and by its actors and roles."@en ;
	arch:includesConcept am:BusinessActor , am:BusinessRole , am:BusinessCollaboration , am:BusinessProcess , am:BusinessFunction , am:BusinessInteraction , am:BusinessEvent , am:BusinessObject , am:ApplicationComponent , am:ApplicationCollaboration , am:ApplicationInterface , am:ApplicationProcess , am:ApplicationFunction , am:ApplicationInteraction , am:ApplicationEvent , am:ApplicationService , am:DataObject , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:EnterpriseArchitect , amvp:ProcessArchitect , amvp:ApplicationArchitect , amvp:OperationalManager ;
	arch:viewpointFramesConcern amvp:Consistency , amvp:Completeness , amvp:ReductionOfComplexity ;
	arch:viewpointHasPurpose amvp:Designing , amvp:Deciding ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:SupportViewpoints , amvp:MultipleLayersMultipleAspects ;
	skos:notation "C.1.8" .
amvp:TechnologyUsageViewpoint a arch:Viewpoint ;
	skos:prefLabel "Technology Usage Viewpoint"@en ;
	skos:definition "How applications use technology: the nodes, system software, networks and technology services that serve them."@en ;
	arch:includesConcept am:ApplicationComponent , am:ApplicationCollaboration , am:ApplicationProcess , am:ApplicationFunction , am:ApplicationInteraction , am:ApplicationEvent , am:DataObject , am:Node , am:Device , am:TechnologyCollaboration , am:SystemSoftware , am:TechnologyInterface , am:CommunicationNetwork , am:Path , am:TechnologyProcess , am:TechnologyFunction , am:TechnologyInteraction , am:TechnologyService , am:TechnologyEvent , am:Artifact , am:Grouping , am:Junction_And , am:Junction_Or ;
	arch:targetsStakeholder amvp:ApplicationArchitect , amvp:InfrastructureArchitect , amvp:OperationalManager ;
	arch:viewpointFramesConcern amvp:Dependencies , amvp:Performance , amvp:Scalability ;
	arch:viewpointHasPurpose amvp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:broader amvp:SupportViewpoints , amvp:MultipleLayersMultipleAspects ;
	skos:notation "C.1.9" .
amvp:BusinessProcessCooperationViewpoint a arch:Viewpoint ;
	skos:prefLabel "Business Process Cooperation Viewpoint"@en ;
	skos:definition "How business processes relate to each other and to their environment: what triggers what, what flows between them, the information they share and the applications that support them."@en ;
