amvp: a owl:Ontology ;
	owl:imports arch: ;
	<http://purl.org/vocab/vann/preferredNamespaceUri> "https://meta.linked.archi/archimate3/viewpoints#" ;
	<http://purl.org/vocab/vann/preferredNamespacePrefix> "amvp" ;
	dct:creator "Kalin Maldzhanski" ;
	dct:title "Linked.Archi ArchiMate 3.2 Example Viewpoints"@en ;
	dct:description "The ArchiMate 3.2 example viewpoints of Appendix C as arch:Viewpoint\nindividuals. Each states the elements it admits (arch:includesConcept — Grouping and the two\njunctions in every one, as the specification allows), its stakeholders (arch:targetsStakeholder),\nthe concerns it frames (arch:viewpointFramesConcern) and its purposes (arch:viewpointHasPurpose). The\ncatalogue groups them twice, as SKOS: by the specification's categories and by the scope its tables\nstate (how many layers and aspects a viewpoint spans). The specification calls them examples, not a\nnormative or exhaustive list; organizations may define their own."@en ;
	dct:created "2022-11-14"^^xsd:date ;
	dct:modified "2026-10-17"^^xsd:date ;
	dct:publisher "Linked.Archi"@en ;
	<http://purl.org/ontology/bibo/status> "draft" ;
	owl:versionIRI <https://meta.linked.archi/archimate3/viewpoints/3.2#> ;
	owl:versionInfo "3.2"@en .
amvp:ViewpointCatalog a skos:ConceptScheme ;
	skos:prefLabel "ArchiMate 3.2 Viewpoint Catalog"@en ;
	dct:description "The Appendix C viewpoints, grouped by the specification's categories and by the scope its tables state."@en ;
	skos:hasTopConcept amvp:ViewpointByCategory , amvp:ViewpointByScope .
amvp:ViewpointByCategory a skos:Concept ;
	skos:prefLabel "Viewpoint by Category"@en ;
	skos:definition "The viewpoints in the specification's grouping (Appendix C)."@en ;
	skos:topConceptOf amvp:ViewpointCatalog ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:BasicViewpoints , amvp:MotivationViewpoints , amvp:StrategyViewpoints , amvp:ImplementationAndMigrationViewpoints .
amvp:ViewpointByScope a skos:Concept ;
	skos:prefLabel "Viewpoint by Scope"@en ;
	skos:definition "The viewpoints by the scope their tables state: how many layers and aspects they span, or the one part of the language they belong to."@en ;
	skos:topConceptOf amvp:ViewpointCatalog ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:SingleLayerSingleAspect , amvp:SingleLayerMultipleAspects , amvp:MultipleLayersSingleAspect , amvp:MultipleLayersMultipleAspects , amvp:ApplicationLayerMultipleAspects , amvp:MotivationOnly , amvp:StrategyOnly , amvp:ImplementationAndMigrationOnly .
amvp:BasicViewpoints a skos:Concept ;
	skos:prefLabel "Basic Viewpoints"@en ;
	skos:definition "The basic viewpoints of the core layers, grouped by the direction they look in (Table 22)."@en ;
	skos:broader amvp:ViewpointByCategory ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:CompositionViewpoints , amvp:SupportViewpoints , amvp:CooperationViewpoints , amvp:RealizationViewpoints .
amvp:CompositionViewpoints a skos:Concept ;
	skos:prefLabel "Composition"@en ;
	skos:definition "Viewpoints that define the internal compositions and aggregations of elements."@en ;
	skos:broader amvp:BasicViewpoints ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:OrganizationViewpoint , amvp:ApplicationStructureViewpoint , amvp:InformationStructureViewpoint , amvp:TechnologyViewpoint , amvp:LayeredViewpoint , amvp:PhysicalViewpoint .
amvp:SupportViewpoints a skos:Concept ;
	skos:prefLabel "Support"@en ;
	skos:definition "Viewpoints that look at elements supported by other elements, typically from one layer upwards."@en ;
	skos:broader amvp:BasicViewpoints ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:ProductViewpoint , amvp:ApplicationUsageViewpoint , amvp:TechnologyUsageViewpoint .
amvp:CooperationViewpoints a skos:Concept ;
	skos:prefLabel "Cooperation"@en ;
	skos:definition "Viewpoints that look at peer elements cooperating with each other, typically across aspects."@en ;
	skos:broader amvp:BasicViewpoints ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:BusinessProcessCooperationViewpoint , amvp:ApplicationCooperationViewpoint .
amvp:RealizationViewpoints a skos:Concept ;
	skos:prefLabel "Realization"@en ;
	skos:definition "Viewpoints that look at elements realizing other elements, typically from one layer downwards."@en ;
	skos:broader amvp:BasicViewpoints ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:ServiceRealizationViewpoint , amvp:ImplementationAndDeploymentViewpoint .
amvp:MotivationViewpoints a skos:Concept ;
	skos:prefLabel "Motivation Viewpoints"@en ;
	skos:definition "Viewpoints for the motivation behind the architecture."@en ;
	skos:broader amvp:ViewpointByCategory ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:StakeholderViewpoint , amvp:GoalRealizationViewpoint , amvp:RequirementsRealizationViewpoint , amvp:MotivationViewpoint .
amvp:StrategyViewpoints a skos:Concept ;
	skos:prefLabel "Strategy Viewpoints"@en ;
	skos:definition "Viewpoints for the strategic direction and make-up of the enterprise."@en ;
	skos:broader amvp:ViewpointByCategory ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:StrategyViewpoint , amvp:CapabilityMapViewpoint , amvp:ValueStreamViewpoint , amvp:OutcomeRealizationViewpoint , amvp:ResourceMapViewpoint .
amvp:ImplementationAndMigrationViewpoints a skos:Concept ;
	skos:prefLabel "Implementation and Migration Viewpoints"@en ;
	skos:definition "Viewpoints for managing architecture change: projects, migration and their relation to the architecture."@en ;
	skos:broader amvp:ViewpointByCategory ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:ProjectViewpoint , amvp:MigrationViewpoint , amvp:ImplementationAndMigrationViewpoint .
amvp:SingleLayerSingleAspect a skos:Concept ;
	skos:prefLabel "Single layer, single aspect"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:OrganizationViewpoint .
amvp:SingleLayerMultipleAspects a skos:Concept ;
	skos:prefLabel "Single layer, multiple aspects"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:ApplicationStructureViewpoint , amvp:TechnologyViewpoint .
amvp:MultipleLayersSingleAspect a skos:Concept ;
	skos:prefLabel "Multiple layers, single aspect"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:InformationStructureViewpoint .
amvp:MultipleLayersMultipleAspects a skos:Concept ;
	skos:prefLabel "Multiple layers, multiple aspects"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	skos:narrower amvp:LayeredViewpoint , amvp:PhysicalViewpoint , amvp:ProductViewpoint , amvp:ApplicationUsageViewpoint , amvp:TechnologyUsageViewpoint , amvp:BusinessProcessCooperationViewpoint , amvp:ServiceRealizationViewpoint , amvp:ImplementationAndDeploymentViewpoint , amvp:ImplementationAndMigrationViewpoint .
amvp:ApplicationLayerMultipleAspects a skos:Concept ;
	skos:prefLabel "Application layer, multiple aspects"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate3/tax#ApplicationLayer> ;
	skos:narrower amvp:ApplicationCooperationViewpoint .
amvp:MotivationOnly a skos:Concept ;
	skos:prefLabel "Motivation"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate3/tax#MotivationAspect> ;
	skos:narrower amvp:StakeholderViewpoint , amvp:GoalRealizationViewpoint , amvp:RequirementsRealizationViewpoint , amvp:MotivationViewpoint .
amvp:StrategyOnly a skos:Concept ;
	skos:prefLabel "Strategy"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate3/tax#StrategyLayer> ;
	skos:narrower amvp:StrategyViewpoint , amvp:CapabilityMapViewpoint , amvp:ValueStreamViewpoint , amvp:OutcomeRealizationViewpoint , amvp:ResourceMapViewpoint .
amvp:ImplementationAndMigrationOnly a skos:Concept ;
	skos:prefLabel "Implementation and Migration"@en ;
	skos:broader amvp:ViewpointByScope ;
	skos:inScheme amvp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate3/tax#ImplementationAndMigrationLayer> ;
	skos:narrower amvp:ProjectViewpoint , amvp:MigrationViewpoint .
amvp:Designing a arch:Purpose ;
	skos:prefLabel "Designing"@en ;
	skos:definition "Creating or refining architecture — structure, integration, deployment."@en .
amvp:Deciding a arch:Purpose ;
	skos:prefLabel "Deciding"@en ;
	skos:definition "Evaluating options and their impact, to support a decision."@en .
amvp:Informing a arch:Purpose ;
	skos:prefLabel "Informing"@en ;
	skos:definition "Communicating architecture to stakeholders — overviews, landscapes, roadmaps."@en .
amvp:Governing a arch:Purpose ;
	skos:prefLabel "Governing"@en ;
	skos:definition "Compliance checking, standards enforcement, migration tracking. Not an Appendix C purpose; deliverable templates use it."@en .
