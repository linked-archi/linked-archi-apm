am4vp: a owl:Ontology ;
	owl:imports arch: ;
	<http://purl.org/vocab/vann/preferredNamespaceUri> "https://meta.linked.archi/archimate4/viewpoints#" ;
	<http://purl.org/vocab/vann/preferredNamespacePrefix> "am4vp" ;
	dct:creator "Kalin Maldzhanski" ;
	dct:title "Linked.Archi ArchiMate 4.0 Viewpoints"@en ;
	dct:description "The ArchiMate 4.0 example viewpoints of Appendix C as arch:Viewpoint\nindividuals. Each states the elements it admits\n(arch:includesConcept — Grouping and the two junctions in every one, as the specification allows),\nits stakeholders (arch:targetsStakeholder), the concerns it frames (arch:viewpointFramesConcern)\nand its purposes (arch:viewpointHasPurpose). The catalogue groups them twice, as SKOS: by the\nspecification's categories and by the scope its tables state (how many domains and aspects a\nviewpoint spans). The specification calls them examples, not a normative or exhaustive list;\norganizations may define their own."@en ;
	dct:created "2026-04-19"^^xsd:date ;
	dct:modified "2026-10-11"^^xsd:date ;
	dct:publisher "Linked.Archi"@en ;
	<http://purl.org/ontology/bibo/status> "draft" ;
	owl:versionIRI <https://meta.linked.archi/archimate4/viewpoints/4.0#> ;
	owl:versionInfo "4.0"@en .
am4vp:ViewpointCatalog a skos:ConceptScheme ;
	skos:prefLabel "ArchiMate 4.0 Viewpoint Catalog"@en ;
	dct:description "The Appendix C viewpoints, grouped by the specification's categories and by the scope its tables state."@en ;
	skos:hasTopConcept am4vp:ViewpointByCategory , am4vp:ViewpointByScope .
am4vp:ViewpointByCategory a skos:Concept ;
	skos:prefLabel "Viewpoint by Category"@en ;
	skos:definition "The viewpoints in the specification's grouping (Appendix C)."@en ;
	skos:topConceptOf am4vp:ViewpointCatalog ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:BasicViewpoints , am4vp:MotivationViewpoints , am4vp:StrategyViewpoints , am4vp:ImplementationAndMigrationViewpoints .
am4vp:ViewpointByScope a skos:Concept ;
	skos:prefLabel "Viewpoint by Scope"@en ;
	skos:definition "The viewpoints by the scope their tables state: how many domains and aspects they span, or the one domain they belong to."@en ;
	skos:topConceptOf am4vp:ViewpointCatalog ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:SingleDomainSingleAspect , am4vp:SingleDomainMultipleAspects , am4vp:MultipleDomainsSingleAspect , am4vp:MultipleDomainsMultipleAspects , am4vp:ApplicationDomainMultipleAspects , am4vp:MotivationDomainOnly , am4vp:StrategyDomainOnly , am4vp:ImplementationAndMigrationDomainOnly .
am4vp:BasicViewpoints a skos:Concept ;
	skos:prefLabel "Basic Viewpoints"@en ;
	skos:definition "The basic viewpoints of the core domains, grouped by the direction they look in (Table C-1)."@en ;
	skos:broader am4vp:ViewpointByCategory ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:CompositionViewpoints , am4vp:SupportViewpoints , am4vp:CooperationViewpoints , am4vp:RealizationViewpoints .
am4vp:CompositionViewpoints a skos:Concept ;
	skos:prefLabel "Composition"@en ;
	skos:definition "Viewpoints that define the internal structure of elements."@en ;
	skos:broader am4vp:BasicViewpoints ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:OrganizationViewpoint , am4vp:ApplicationStructureViewpoint , am4vp:InformationStructureViewpoint , am4vp:TechnologyViewpoint , am4vp:LayeredViewpoint , am4vp:PhysicalViewpoint .
am4vp:SupportViewpoints a skos:Concept ;
	skos:prefLabel "Support"@en ;
	skos:definition "Viewpoints that look at elements supported by other elements."@en ;
	skos:broader am4vp:BasicViewpoints ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:ProductViewpoint , am4vp:ApplicationUsageViewpoint , am4vp:TechnologyUsageViewpoint .
am4vp:CooperationViewpoints a skos:Concept ;
	skos:prefLabel "Cooperation"@en ;
	skos:definition "Viewpoints that look at peer elements cooperating with each other, typically across aspects."@en ;
	skos:broader am4vp:BasicViewpoints ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:ProcessCooperationViewpoint , am4vp:ApplicationCooperationViewpoint .
am4vp:RealizationViewpoints a skos:Concept ;
	skos:prefLabel "Realization"@en ;
	skos:definition "Viewpoints that look at elements realizing other elements."@en ;
	skos:broader am4vp:BasicViewpoints ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:ServiceRealizationViewpoint , am4vp:ImplementationAndDeploymentViewpoint .
am4vp:MotivationViewpoints a skos:Concept ;
	skos:prefLabel "Motivation Viewpoints"@en ;
	skos:definition "Viewpoints for the motivation behind the architecture."@en ;
	skos:broader am4vp:ViewpointByCategory ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:StakeholderViewpoint , am4vp:GoalRealizationViewpoint , am4vp:RequirementsRealizationViewpoint , am4vp:MotivationViewpoint .
am4vp:StrategyViewpoints a skos:Concept ;
	skos:prefLabel "Strategy Viewpoints"@en ;
	skos:definition "Viewpoints for the strategic direction and make-up of the enterprise."@en ;
	skos:broader am4vp:ViewpointByCategory ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:StrategyViewpoint , am4vp:CapabilityMapViewpoint , am4vp:ValueStreamViewpoint , am4vp:OutcomeRealizationViewpoint , am4vp:ResourceMapViewpoint .
am4vp:ImplementationAndMigrationViewpoints a skos:Concept ;
	skos:prefLabel "Implementation and Migration Viewpoints"@en ;
	skos:definition "Viewpoints for managing architecture change: projects, migration and their relation to the architecture."@en ;
	skos:broader am4vp:ViewpointByCategory ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:ProjectViewpoint , am4vp:MigrationViewpoint , am4vp:ImplementationAndMigrationViewpoint .
am4vp:SingleDomainSingleAspect a skos:Concept ;
	skos:prefLabel "Single domain, single aspect"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:OrganizationViewpoint .
am4vp:SingleDomainMultipleAspects a skos:Concept ;
	skos:prefLabel "Single domain, multiple aspects"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:ApplicationStructureViewpoint , am4vp:TechnologyViewpoint .
am4vp:MultipleDomainsSingleAspect a skos:Concept ;
	skos:prefLabel "Multiple domains, single aspect"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:InformationStructureViewpoint .
am4vp:MultipleDomainsMultipleAspects a skos:Concept ;
	skos:prefLabel "Multiple domains, multiple aspects"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:narrower am4vp:LayeredViewpoint , am4vp:PhysicalViewpoint , am4vp:ProductViewpoint , am4vp:ApplicationUsageViewpoint , am4vp:TechnologyUsageViewpoint , am4vp:ProcessCooperationViewpoint , am4vp:ServiceRealizationViewpoint , am4vp:ImplementationAndDeploymentViewpoint , am4vp:ImplementationAndMigrationViewpoint .
am4vp:ApplicationDomainMultipleAspects a skos:Concept ;
	skos:prefLabel "Application domain, multiple aspects"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate4/tax#ApplicationDomain> ;
	skos:narrower am4vp:ApplicationCooperationViewpoint .
am4vp:MotivationDomainOnly a skos:Concept ;
	skos:prefLabel "Motivation domain"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate4/tax#MotivationDomain> ;
	skos:narrower am4vp:StakeholderViewpoint , am4vp:GoalRealizationViewpoint , am4vp:RequirementsRealizationViewpoint , am4vp:MotivationViewpoint .
am4vp:StrategyDomainOnly a skos:Concept ;
	skos:prefLabel "Strategy domain"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate4/tax#StrategyDomain> ;
	skos:narrower am4vp:StrategyViewpoint , am4vp:CapabilityMapViewpoint , am4vp:ValueStreamViewpoint , am4vp:OutcomeRealizationViewpoint , am4vp:ResourceMapViewpoint .
am4vp:ImplementationAndMigrationDomainOnly a skos:Concept ;
	skos:prefLabel "Implementation and Migration domain"@en ;
	skos:broader am4vp:ViewpointByScope ;
	skos:inScheme am4vp:ViewpointCatalog ;
	rdfs:seeAlso <https://meta.linked.archi/archimate4/tax#ImplementationAndMigrationDomain> ;
	skos:narrower am4vp:ProjectViewpoint , am4vp:MigrationViewpoint .
am4vp:Designing a arch:Purpose ;
	skos:prefLabel "Designing"@en ;
	skos:definition "Creating or refining architecture — structure, integration, deployment."@en .
am4vp:Deciding a arch:Purpose ;
	skos:prefLabel "Deciding"@en ;
	skos:definition "Evaluating options and their impact, to support a decision."@en .
am4vp:Informing a arch:Purpose ;
	skos:prefLabel "Informing"@en ;
	skos:definition "Communicating architecture to stakeholders — overviews, landscapes, roadmaps."@en .
am4vp:Governing a arch:Purpose ;
	skos:prefLabel "Governing"@en ;
	skos:definition "Compliance checking, standards enforcement, migration tracking. Not an Appendix C purpose; deliverable templates use it."@en .
