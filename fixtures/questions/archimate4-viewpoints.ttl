am4vp:OrganizationViewpoint a arch:Viewpoint ;
	skos:prefLabel "Organization Viewpoint"@en ;
	skos:definition "The structure of an organization: its actors, roles and collaborations, where they are, and the interfaces through which they are reached."@en ;
	arch:includesConcept am4:BusinessActor , am4:Role , am4:Collaboration , am4:Location , am4:BusinessInterface , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:EnterpriseArchitect , am4vp:ProcessArchitect , am4vp:DomainArchitect , am4vp:Manager , am4vp:Employee , am4vp:Shareholder ;
	arch:viewpointFramesConcern am4vp:CompetenciesAuthorityResponsibilities ;
	arch:viewpointHasPurpose am4vp:Designing , am4vp:Deciding , am4vp:Informing ;
	arch:viewType arch:Diagram , arch:Catalog ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:SingleDomainSingleAspect .
am4vp:ApplicationStructureViewpoint a arch:Viewpoint ;
	skos:prefLabel "Application Structure Viewpoint"@en ;
	skos:definition "The structure of an application: its components, interfaces and data, and the collaborations it takes part in."@en ;
	arch:includesConcept am4:ApplicationComponent , am4:ApplicationInterface , am4:Collaboration , am4:DataObject , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:ApplicationArchitect , am4vp:SolutionArchitect ;
	arch:viewpointFramesConcern am4vp:ApplicationStructure , am4vp:Consistency , am4vp:Completeness , am4vp:ReductionOfComplexity ;
	arch:viewpointHasPurpose am4vp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:SingleDomainMultipleAspects .
am4vp:InformationStructureViewpoint a arch:Viewpoint ;
	skos:prefLabel "Information Structure Viewpoint"@en ;
	skos:definition "The structure of the information the enterprise uses: business and data objects, the artifacts that hold them and what they mean."@en ;
	arch:includesConcept am4:BusinessObject , am4:DataObject , am4:Artifact , am4:Meaning , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:DomainArchitect , am4vp:InformationArchitect ;
	arch:viewpointFramesConcern am4vp:InformationStructure , am4vp:Consistency , am4vp:Completeness ;
	arch:viewpointHasPurpose am4vp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:MultipleDomainsSingleAspect .
am4vp:TechnologyViewpoint a arch:Viewpoint ;
	skos:prefLabel "Technology Viewpoint"@en ;
	skos:definition "The infrastructure and platforms beneath the information systems — nodes, devices, system software and networks — and the technology behaviour they offer."@en ;
	arch:includesConcept am4:Location , am4:Node , am4:Collaboration , am4:Device , am4:SystemSoftware , am4:TechnologyInterface , am4:CommunicationNetwork , am4:Path , am4:Process , am4:Function , am4:Service , am4:Event , am4:Artifact , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:InfrastructureArchitect , am4vp:OperationalManager ;
	arch:viewpointFramesConcern am4vp:InfrastructureQuality ;
	arch:viewpointHasPurpose am4vp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:SingleDomainMultipleAspects .
am4vp:LayeredViewpoint a arch:Viewpoint ;
	skos:prefLabel "Layered Viewpoint"@en ;
	skos:definition "An overview of the architecture across its core domains: every core element, and every relationship, may appear."@en ;
	arch:includesConcept am4:Role , am4:Collaboration , am4:Path , am4:Process , am4:Function , am4:Event , am4:Service , am4:Location , am4:BusinessActor , am4:BusinessInterface , am4:BusinessObject , am4:Product , am4:ApplicationComponent , am4:ApplicationInterface , am4:DataObject , am4:Node , am4:Device , am4:SystemSoftware , am4:TechnologyInterface , am4:CommunicationNetwork , am4:DistributionNetwork , am4:Equipment , am4:Facility , am4:Material , am4:Artifact , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:EnterpriseArchitect , am4vp:ProcessArchitect , am4vp:ApplicationArchitect , am4vp:InfrastructureArchitect , am4vp:DomainArchitect ;
	arch:viewpointFramesConcern am4vp:Consistency , am4vp:ReductionOfComplexity , am4vp:ImpactOfChange , am4vp:Flexibility ;
	arch:viewpointHasPurpose am4vp:Designing , am4vp:Deciding , am4vp:Informing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:MultipleDomainsMultipleAspects .
am4vp:PhysicalViewpoint a arch:Viewpoint ;
	skos:prefLabel "Physical Viewpoint"@en ;
	skos:definition "The physical environment — equipment, facilities, distribution networks and materials — and how it relates to the IT infrastructure."@en ;
	arch:includesConcept am4:Location , am4:Node , am4:Device , am4:Equipment , am4:Facility , am4:Path , am4:CommunicationNetwork , am4:DistributionNetwork , am4:Material , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:InfrastructureArchitect , am4vp:OperationalManager ;
	arch:viewpointFramesConcern am4vp:PhysicalEnvironment ;
	arch:viewpointHasPurpose am4vp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:CompositionViewpoints , am4vp:MultipleDomainsMultipleAspects .
am4vp:ProductViewpoint a arch:Viewpoint ;
	skos:prefLabel "Product Viewpoint"@en ;
	skos:definition "What a product contains: the services, behaviour, objects and value it offers, and who delivers it."@en ;
	arch:includesConcept am4:BusinessActor , am4:Role , am4:Collaboration , am4:BusinessInterface , am4:Process , am4:Function , am4:Event , am4:Service , am4:BusinessObject , am4:Product , am4:ApplicationComponent , am4:ApplicationInterface , am4:DataObject , am4:Artifact , am4:Material , am4:Value , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:ProductDeveloper , am4vp:ProductManager , am4vp:ProcessArchitect , am4vp:DomainArchitect ;
	arch:viewpointFramesConcern am4vp:ProductDevelopment , am4vp:ProductValue ;
	arch:viewpointHasPurpose am4vp:Designing , am4vp:Deciding ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:SupportViewpoints , am4vp:MultipleDomainsMultipleAspects .
am4vp:ApplicationUsageViewpoint a arch:Viewpoint ;
	skos:prefLabel "Application Usage Viewpoint"@en ;
	skos:definition "How applications are used in the enterprise's processes and functions, and by its actors and roles."@en ;
	arch:includesConcept am4:BusinessActor , am4:Role , am4:Collaboration , am4:Process , am4:Function , am4:Event , am4:BusinessObject , am4:ApplicationComponent , am4:ApplicationInterface , am4:Service , am4:DataObject , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:EnterpriseArchitect , am4vp:ProcessArchitect , am4vp:ApplicationArchitect , am4vp:OperationalManager ;
	arch:viewpointFramesConcern am4vp:Consistency , am4vp:Completeness , am4vp:ReductionOfComplexity ;
	arch:viewpointHasPurpose am4vp:Designing , am4vp:Deciding ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:SupportViewpoints , am4vp:MultipleDomainsMultipleAspects .
am4vp:TechnologyUsageViewpoint a arch:Viewpoint ;
	skos:prefLabel "Technology Usage Viewpoint"@en ;
	skos:definition "How applications use technology: the nodes, system software and networks that serve them."@en ;
	arch:includesConcept am4:ApplicationComponent , am4:Service , am4:Process , am4:Function , am4:Event , am4:DataObject , am4:Node , am4:Device , am4:Collaboration , am4:SystemSoftware , am4:TechnologyInterface , am4:CommunicationNetwork , am4:Path , am4:Artifact , am4:Grouping , am4:AndJunction , am4:OrJunction ;
	arch:targetsStakeholder am4vp:ApplicationArchitect , am4vp:InfrastructureArchitect , am4vp:OperationalManager ;
	arch:viewpointFramesConcern am4vp:Dependencies , am4vp:Performance , am4vp:Scalability ;
	arch:viewpointHasPurpose am4vp:Designing ;
	arch:viewType arch:Diagram ;
	skos:inScheme am4vp:ViewpointCatalog ;
	skos:broader am4vp:SupportViewpoints , am4vp:MultipleDomainsMultipleAspects .
am4vp:ProcessCooperationViewpoint a arch:Viewpoint ;
	skos:prefLabel "Process Cooperation Viewpoint"@en ;
	skos:definition "How processes relate to each other and to their environment: what triggers what, what flows between them, the data they share and the services they realize."@en ;
