	bpmn:EventBasedGateway a <http://www.w3.org/2002/07/owl#Class> ;
		skos:prefLabel "EventBasedGateway"@en ;
		<http://www.w3.org/2000/01/rdf-schema#subClassOf> bpmn:Gateway .
