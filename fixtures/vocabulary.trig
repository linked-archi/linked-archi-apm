	bpmn:Collaboration a <http://www.w3.org/2002/07/owl#Class> ;
		skos:prefLabel "Collaboration"@en ;
		<http://www.w3.org/2000/01/rdf-schema#subClassOf> bpmn:RootElement , arch:Element .
	bpmn:Choreography a <http://www.w3.org/2002/07/owl#Class> ;
		skos:prefLabel "Choreography"@en ;
		<http://www.w3.org/2000/01/rdf-schema#subClassOf> bpmn:FlowElementsContainer , bpmn:Collaboration .
	bpmn:ChoreographyTask a <http://www.w3.org/2002/07/owl#Class> ;
		skos:prefLabel "ChoreographyTask"@en ;
