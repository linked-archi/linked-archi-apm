		<http://www.w3.org/2000/01/rdf-schema#subClassOf> bpmn:ConversationNode .
	bpmn:ConversationNode a <http://www.w3.org/2002/07/owl#Class> ;
		skos:prefLabel "ConversationNode"@en ;
		<http://www.w3.org/2000/01/rdf-schema#subClassOf> bpmn:InteractionNode , bpmn:BaseElement , arch:Element .
	<https://meta.linked.archi/bpmn/tax#FlowObjects> a skos:Concept ;
		skos:prefLabel "Flow Objects"@en ;
		skos:definition "The main graphical elements within a process flow: activities, events, and gateways."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#ConnectingObjects> a skos:Concept ;
		skos:prefLabel "Connecting Objects"@en ;
		skos:definition "Elements connecting flow objects: sequence flows, message flows, associations."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#SwimLanes> a skos:Concept ;
		skos:prefLabel "Swim Lanes"@en ;
		skos:definition "Organizational groupings: pools and lanes."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#Artifacts> a skos:Concept ;
		skos:prefLabel "Artifacts"@en ;
		skos:definition "Data-related and annotation elements: data objects, data stores, groups, text annotations."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#Collaborations> a skos:Concept ;
		skos:prefLabel "Collaborations"@en ;
		skos:definition "Collaboration, choreography, and conversation elements."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#Activities> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#FlowObjects> ;
		skos:prefLabel "Activities"@en ;
		skos:definition "Work performed within a business process — tasks and sub-processes."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Process , bpmn:SubProcess , bpmn:Task , bpmn:UserTask , bpmn:ServiceTask , bpmn:SendTask , bpmn:ReceiveTask , bpmn:ScriptTask , bpmn:BusinessRuleTask , bpmn:ManualTask , bpmn:CallActivity , bpmn:AdHocSubProcess , bpmn:Transaction .
	<https://meta.linked.archi/bpmn/tax#Events> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#FlowObjects> ;
		skos:prefLabel "Events"@en ;
		skos:definition "Things that happen during a process: start, intermediate, and end events."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:StartEvent , bpmn:EndEvent , bpmn:IntermediateCatchEvent , bpmn:IntermediateThrowEvent , bpmn:BoundaryEvent .
	<https://meta.linked.archi/bpmn/tax#Gateways> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#FlowObjects> ;
		skos:prefLabel "Gateways"@en ;
		skos:definition "Control flow divergence and convergence."@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:ExclusiveGateway , bpmn:ParallelGateway , bpmn:InclusiveGateway , bpmn:EventBasedGateway , bpmn:ComplexGateway .
	<https://meta.linked.archi/bpmn/tax#SequenceFlowConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#ConnectingObjects> ;
		skos:prefLabel "Sequence Flow"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#MessageFlowConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#ConnectingObjects> ;
		skos:prefLabel "Message Flow"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#AssociationConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#ConnectingObjects> ;
		skos:prefLabel "Association"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#DataAssociationConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#ConnectingObjects> ;
		skos:prefLabel "Data Association"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> .
	<https://meta.linked.archi/bpmn/tax#PoolConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#SwimLanes> ;
		skos:prefLabel "Pool (Participant)"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Participant .
	<https://meta.linked.archi/bpmn/tax#LaneConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#SwimLanes> ;
		skos:prefLabel "Lane"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Lane .
	<https://meta.linked.archi/bpmn/tax#DataObjectConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Artifacts> ;
		skos:prefLabel "Data Object"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:DataObject , bpmn:DataObjectReference .
	<https://meta.linked.archi/bpmn/tax#DataStoreConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Artifacts> ;
		skos:prefLabel "Data Store"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:DataStoreReference .
	<https://meta.linked.archi/bpmn/tax#MessageConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Artifacts> ;
		skos:prefLabel "Message"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Message .
	<https://meta.linked.archi/bpmn/tax#GroupConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Artifacts> ;
		skos:prefLabel "Group"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Group .
	<https://meta.linked.archi/bpmn/tax#TextAnnotationConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Artifacts> ;
		skos:prefLabel "Text Annotation"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:TextAnnotation .
	<https://meta.linked.archi/bpmn/tax#CollaborationConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Collaborations> ;
		skos:prefLabel "Collaboration"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Collaboration .
	<https://meta.linked.archi/bpmn/tax#ChoreographyConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Collaborations> ;
		skos:prefLabel "Choreography"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Choreography , bpmn:ChoreographyTask .
	<https://meta.linked.archi/bpmn/tax#ConversationConcept> a skos:Concept ;
		skos:broader <https://meta.linked.archi/bpmn/tax#Collaborations> ;
		skos:prefLabel "Conversation"@en ;
		skos:inScheme <https://meta.linked.archi/bpmn/tax#> ;
		skos:narrower bpmn:Conversation , bpmn:ConversationNode .
