<https://meta.linked.archi/bpmn/tax#Activities> skos:narrower bpmn:Transaction , bpmn:AdHocSubProcess , bpmn:CallActivity , bpmn:ManualTask , bpmn:BusinessRuleTask , bpmn:ScriptTask , bpmn:ReceiveTask , bpmn:SendTask , bpmn:ServiceTask , bpmn:UserTask , bpmn:Task , bpmn:SubProcess , bpmn:Process ;
